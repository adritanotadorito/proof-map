# Copy to .env.local and fill in. Never commit .env.local.

# From your GitHub App's settings page (General tab).
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# The last part of the app's public URL: https://github.com/apps/<slug>
GITHUB_APP_SLUG=

# Where this app runs. Must match the callback URL registered on the GitHub App.
APP_URL=http://localhost:3000
# On Vercel set APP_URL=https://<your-production-domain> (no trailing slash).

# Encrypts the session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Reviewer model (Google AI Studio). The key is used only on the server.
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.8-flash.
# GEMINI_MODEL=gemini-3.8-flash

# Durable record store for reviews and decisions (required on Vercel; local dev falls back to .data/).
# Set automatically by Vercel's Upstash Redis integration.
KV_REST_API_URL=
KV_REST_API_TOKEN=
